# ==========================================================
# 橙心售后 · 后端环境变量示例
# 复制为 .env 后再填写真实值，.env 不会提交到 Git
#   cp .env.example .env
# ==========================================================

APP_NAME=orange-after-sale
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# MySQL
# 如果密码包含 @、:、/ 等字符，需要做 URL 编码
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@HOST:3306/after_sale_agent?charset=utf8mb4
DB_ECHO=false

# 登录会话
# 三端独立登录；session token 有效期 72 小时
SESSION_TTL_DAYS=3

# 平台客服注册邀请码；请改成自己的值
PLATFORM_REGISTER_INVITE_CODE=CHANGE_ME_PLATFORM_INVITE_CODE

# DeepSeek / OpenAI 兼容接口
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# 没有配置 Key 或模型不可用时，是否允许本地规则降级
LLM_FALLBACK_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.65

# 第一版使用简单顺序编排；后续切换到 langgraph
AGENT_ORCHESTRATOR=simple
